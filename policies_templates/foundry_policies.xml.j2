<policies>
    <inbound>
        <base />

        {% if enable_cors %}
        <cors allow-credentials="true">
            <allowed-origins>
                {# Check if it's a wildcard or a list of specific sites #}
                {% if cors_origins == "*" %}
                <origin>*</origin>
                {% else %}
                {# Split the comma-separated string from Python and loop #}
                {% for origin in cors_origins.split(',') %}
                <origin>{{ origin.strip() }}</origin>
                {% endfor %}
                {% endif %}
            </allowed-origins>
            <allowed-methods>
                {# For Foundry/AI, usually POST and OPTIONS are enough #}
                <method>*</method>
            </allowed-methods>
            <allowed-headers>
                <header>*</header>
            </allowed-headers>
        </cors>
        {% endif %}

        <authentication-managed-identity
            resource="https://cognitiveservices.azure.com"
            output-token-variable-name="msi-token"
            ignore-error="false" />

        <set-header name="Authorization" exists-action="override">
            <value>@("Bearer " + (string)context.Variables["msi-token"])</value>
        </set-header>

        <rate-limit-by-key
            calls="{{ rate_limit }}"
            renewal-period="{{ rate_period }}"
            counter-key="@(
                {%- if limit_by == 'both' -%}
                    context.Request.IpAddress + context.Subscription.Id
                {%- elif limit_by == 'ip' -%}
                    context.Request.IpAddress
                {%- else -%}
                    context.Subscription.Id
                {%- endif -%}
            )" />

        {% if quota and quota | int > 0 %}
        <quota-by-key
            calls="{{ quota }}"
            renewal-period="3600"
            counter-key="@(
                {%- if limit_by == 'both' -%}
                    context.Request.IpAddress + context.Subscription.Id
                {%- elif limit_by == 'ip' -%}
                    context.Request.IpAddress
                {%- else -%}
                    context.Subscription.Id
                {%- endif -%}
            )" />
        {% endif %}

        <set-backend-service base-url="{{ backend_url }}" />

    </inbound>
    <backend>
        <base />
    </backend>
    <outbound>
        <base />
    </outbound>
    <on-error>
        <base />
    </on-error>
</policies>