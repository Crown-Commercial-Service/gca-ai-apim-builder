terraform {
  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = ">= 3.0.0"
    }
  }
}

# 1. The APIM Service Instance connect to existing APIM
data "azurerm_api_management" "apim" {
  name                = "AzP-UKS-APIM"
  resource_group_name = "AzP-UKS-Shared"
}

# 2. The Backend Connection
resource "azurerm_api_management_backend" "app_backend" {
  name                = "{{ api_suffix }}-backend"
  resource_group_name = data.azurerm_api_management.apim.resource_group_name
  api_management_name = data.azurerm_api_management.apim.name
  protocol            = "http"
  url                 = "{{ backend_url }}"
}

# 3. The API Definition (Importing your cleaned JSON)
resource "azurerm_api_management_api" "apim_api" {
  name                = "{{ api_suffix }}-api"
  resource_group_name = data.azurerm_api_management.apim.resource_group_name
  api_management_name = data.azurerm_api_management.apim.name
  revision            = "1"
  display_name        = "{{ display_name }}"
  path                = "{{ api_suffix }}"
  protocols           = ["https"]
  service_url         = "{{ backend_url }}"

  subscription_required = {{ sub_required | lower }}

  import {
    content_format = "openapi+json"
    content_value  = file("${path.module}/openapi.json")
  }
}

# 4. Product (The 'Package' for the API)
resource "azurerm_api_management_product" "apim_product" {
  product_id            = "{{ api_suffix }}-product"
  api_management_name   = data.azurerm_api_management.apim.name
  resource_group_name   = data.azurerm_api_management.apim.resource_group_name
  display_name          = "{{ display_name }} Product"
  subscription_required = {{ sub_required | lower }}
  approval_required     = false
  published             = true
}

# 5. Linking API to Product
resource "azurerm_api_management_product_api" "product_api_link" {
  api_name            = azurerm_api_management_api.apim_api.name
  product_id          = azurerm_api_management_product.apim_product.product_id
  api_management_name = data.azurerm_api_management.apim.name
  resource_group_name = data.azurerm_api_management.apim.resource_group_name
}

{% if sub_required %}
# 6. Subscription (The actual API Key)
resource "azurerm_api_management_subscription" "user_subscription" {
  api_management_name = data.azurerm_api_management.apim.name
  resource_group_name = data.azurerm_api_management.apim.resource_group_name
  product_id          = azurerm_api_management_product.apim_product.id
  display_name        = "{{ display_name }} Subscription Key"
  state               = "active"
}
{% endif %}

# 7. Policy (CORS, Rate Limits, etc.)
resource "azurerm_api_management_api_policy" "apim_policy" {
  api_name            = azurerm_api_management_api.apim_api.name
  api_management_name = data.azurerm_api_management.apim.name
  resource_group_name = data.azurerm_api_management.apim.resource_group_name

  xml_content = file("${path.module}/policies.xml")

  depends_on = [
    azurerm_api_management_api.apim_api,
    azurerm_api_management_backend.app_backend
  ]
}


output "gateway_url" {

  value = "${data.azurerm_api_management.apim.gateway_url}/${azurerm_api_management_api.apim_api.path}"
}