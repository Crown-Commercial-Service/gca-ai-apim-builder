terraform {
  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = ">= 3.0.0"
    }
  }
}

# 1. Reference the existing APIM service
data "azurerm_api_management" "apim" {
  name                = "AzP-UKS-APIM"
  resource_group_name = "AzP-UKS-Shared"
}

# 2. The Backend
resource "azurerm_api_management_backend" "foundry_backend" {
  name                = "{{ api_suffix }}-backend"
  resource_group_name = data.azurerm_api_management.apim.resource_group_name
  api_management_name = data.azurerm_api_management.apim.name
  protocol            = "http"
  url                 = "{{ backend_url }}"
}

# 3. The API Definition
resource "azurerm_api_management_api" "foundry_api" {
  name                = "{{ api_suffix }}-api"
  resource_group_name = data.azurerm_api_management.apim.resource_group_name
  api_management_name = data.azurerm_api_management.apim.name
  revision            = "1"
  display_name        = "{{ display_name }} ({{ model_name }})"
  path                = "{{ api_suffix }}"
  protocols           = ["https"]

  subscription_required = {{ sub_required | lower }}

  import {
    content_format = "openapi+json"
    content_value  = file("${path.module}/openapi.json")
  }
}

# 4. ENTRA ID ROLE ASSIGNMENT
resource "azurerm_role_assignment" "ai_foundry_access" {
  scope                = "{{ entra_resource_id }}"
  role_definition_name = "Cognitive Services OpenAI User" 
  principal_id         = data.azurerm_api_management.apim.identity[0].principal_id
}

# 5. PRODUCT (The 'Key' Container)
resource "azurerm_api_management_product" "foundry_product" {
  product_id            = "{{ api_suffix }}-product"
  api_management_name   = data.azurerm_api_management.apim.name
  resource_group_name   = data.azurerm_api_management.apim.resource_group_name
  display_name          = "{{ display_name }} Product"
  subscription_required = true
  published             = true
}

# 6. LINKING API TO PRODUCT
resource "azurerm_api_management_product_api" "link" {
  api_name            = azurerm_api_management_api.foundry_api.name
  product_id          = azurerm_api_management_product.foundry_product.product_id
  api_management_name = data.azurerm_api_management.apim.name
  resource_group_name = data.azurerm_api_management.apim.resource_group_name
}

# 7. Policy Application
resource "azurerm_api_management_api_policy" "foundry_policy" {
  api_name            = azurerm_api_management_api.foundry_api.name
  api_management_name = data.azurerm_api_management.apim.name
  resource_group_name = data.azurerm_api_management.apim.resource_group_name
  xml_content         = file("${path.module}/policies.xml")

  depends_on = [
    azurerm_role_assignment.ai_foundry_access,
    azurerm_api_management_product_api.link
  ]
}

# 8. Output the final URL
output "gateway_url" {
  value = "${data.azurerm_api_management.apim.gateway_url}/${azurerm_api_management_api.foundry_api.path}"
}